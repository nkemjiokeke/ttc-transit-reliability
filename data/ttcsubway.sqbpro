<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="ttcsubway.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser query pragmas" current="2"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="1550"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="ttc_subway_delays_clean" custom_title="0" dock_id="1" table="4,23:mainttc_subway_delays_clean"/><dock_state state="000000ff00000000fd00000001000000020000077400000386fc0100000001fb000000160064006f0063006b00420072006f0077007300650031010000000000000774000001aa00ffffff000002650000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings><table schema="main" name="ttc_subway_delays_clean" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="85"/><column index="2" value="78"/><column index="3" value="179"/><column index="4" value="46"/><column index="5" value="300"/><column index="6" value="187"/><column index="7" value="66"/><column index="8" value="57"/><column index="9" value="43"/><column index="10" value="187"/><column index="11" value="34"/><column index="12" value="39"/><column index="13" value="35"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="Baseline*">SELECT COUNT(*)                       AS delay_incidents,
       SUM(min_delay)                 AS total_delay_min,
       ROUND(AVG(min_delay),1)        AS avg_delay_min,
       ROUND(SUM(min_delay)/60.0,0)   AS total_delay_hours
FROM ttc_subway_delays_clean
WHERE min_delay &gt; 0;</sql><sql name="Minutes_cause_and_line*">SELECT cause_family,
       SUM(min_delay)                                                                   AS delay_min,
       ROUND(SUM(min_delay)*100.0/(SELECT SUM(min_delay) FROM ttc_subway_delays_clean WHERE min_delay&gt;0),1) AS pct_of_total,
       COUNT(*)                                                                          AS incidents,
       ROUND(AVG(min_delay),1)                                                           AS avg_min
FROM ttc_subway_delays_clean WHERE min_delay&gt;0
GROUP BY cause_family
ORDER BY delay_min DESC;</sql><sql name="SQL 3*">SELECT line, SUM(min_delay) AS delay_min, COUNT(*) AS incidents, ROUND(AVG(min_delay),1) AS avg_min
FROM ttc_subway_delays_clean WHERE min_delay&gt;0
GROUP BY line
ORDER BY delay_min DESC;</sql><sql name="SQL 4*">WITH s AS (
  SELECT station, SUM(min_delay) AS dm, COUNT(*) AS inc
  FROM ttc_subway_delays_clean WHERE min_delay&gt;0 GROUP BY station
)
SELECT station, dm AS delay_min, inc AS incidents,
       ROUND(100.0*dm/SUM(dm) OVER (),1)                          AS pct,
       ROUND(100.0*SUM(dm) OVER (ORDER BY dm DESC)/SUM(dm) OVER (),1) AS cum_pct
FROM s ORDER BY dm DESC LIMIT 20;</sql><sql name="SQL 5*">SELECT CASE WHEN peak=1 THEN 'Rush hour (7-9, 16-18)' ELSE 'Off-peak' END AS period,
       SUM(min_delay) AS delay_min,
       ROUND(SUM(min_delay)*100.0/(SELECT SUM(min_delay) FROM ttc_subway_delays_clean WHERE min_delay&gt;0),1) AS pct,
       COUNT(*) AS incidents
FROM ttc_subway_delays_clean WHERE min_delay&gt;0 GROUP BY period;</sql><sql name="SQL 6*">SELECT hour, SUM(min_delay) AS delay_min, COUNT(*) AS incidents
FROM ttc_subway_delays_clean WHERE min_delay&gt;0 GROUP BY hour ORDER BY hour;</sql><current_tab id="5"/></tab_sql></sqlb_project>
